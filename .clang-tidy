---
Checks:
  - '-*'
  - 'bugprone-*'
  - '-bugprone-easily-swappable-parameters'  # adjacent parameters of 1 type are not defects, and strong types would churn public signatures
  - 'performance-*'
  - 'readability-identifier-naming'
  - 'readability-redundant-*'
  - 'readability-misleading-indentation'
  - 'readability-container-size-empty'
  - 'readability-make-member-function-const'
  - 'misc-unused-using-decls'
  - 'misc-redundant-expression'
  - 'clang-diagnostic-shadow'
  - 'clang-diagnostic-shadow-field'

WarningsAsErrors: '*'

HeaderFilterRegex: '.*[/\](include[/\]rex|src|tests)[/\].*'

# Submodules are not edited in this repository
ExcludeHeaderFilterRegex: '.*[/\]thirdparty[/\].*'

CheckOptions:
  # Kernel export names are frozen (charter 4.9), ___tracy_ names are generated by Tracy's zone macros, third party, __ImageBase is the linker's module base symbol, and __start_rexguest and __stop_rexguest are the linker's section bounds
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '^__imp__.*;^___tracy_.*;^.*_entry$;^__ImageBase$;^__start_rexguest$;^__stop_rexguest$'
  # Classes and structs
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase

  # Functions and methods
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase

  # Variables
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  # Member variables
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.MemberSuffix
    value: '_'
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.PublicMemberSuffix
    value: ''

  # Constants
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k'
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: 'k'
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k'

  # Enums
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  # Enumerators are kCamelCase, and a digit group may follow the prefix so Xenos formats keep their hardware names (charter 7.13)
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: 'k'

  # Namespaces
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # Template parameters
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.TypeTemplateParameterCase
    value: CamelCase

  # Type aliases
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase

  # Macros
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # XDK and Win32 mirror types
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^(X_FILE_DIRECTORY_INFORMATION)$'
  # named by the C++ standard, X_STATUS, X_ERROR and X_E values
  - key: readability-identifier-naming.ConstexprVariableIgnoredRegexp
    value: '^(X_ERROR_ACCESS_DENIED|X_ERROR_ALREADY_EXISTS|X_ERROR_BAD_ARGUMENTS|X_ERROR_BUSY|X_ERROR_CANCELLED|X_ERROR_DEVICE_NOT_CONNECTED|X_ERROR_EMPTY|X_ERROR_FILE_NOT_FOUND|X_ERROR_FUNCTION_FAILED|X_ERROR_INSUFFICIENT_BUFFER|X_ERROR_INVALID_HANDLE|X_ERROR_INVALID_NAME|X_ERROR_INVALID_PARAMETER|X_ERROR_IO_INCOMPLETE|X_ERROR_IO_PENDING|X_ERROR_NOT_ENOUGH_MEMORY|X_ERROR_NOT_FOUND|X_ERROR_NOT_LOGGED_ON|X_ERROR_NO_MORE_FILES|X_ERROR_NO_SUCH_USER|X_ERROR_PATH_NOT_FOUND|X_ERROR_SUCCESS|X_E_DEVICE_NOT_CONNECTED|X_E_FAIL|X_E_FALSE|X_E_INVALIDARG|X_E_NOTFOUND|X_E_NO_MORE_FILES|X_E_NO_SUCH_USER|X_E_SUCCESS|X_STATUS_ABANDONED_WAIT_0|X_STATUS_ACCESS_DENIED|X_STATUS_ACCESS_VIOLATION|X_STATUS_ALERTED|X_STATUS_ALREADY_COMMITTED|X_STATUS_BUFFER_OVERFLOW|X_STATUS_BUFFER_TOO_SMALL|X_STATUS_DLL_NOT_FOUND|X_STATUS_DRIVER_ENTRYPOINT_NOT_FOUND|X_STATUS_DRIVER_ORDINAL_NOT_FOUND|X_STATUS_END_OF_FILE|X_STATUS_ENTRYPOINT_NOT_FOUND|X_STATUS_FILE_IS_A_DIRECTORY|X_STATUS_INFO_LENGTH_MISMATCH|X_STATUS_INSUFFICIENT_RESOURCES|X_STATUS_INVALID_HANDLE|X_STATUS_INVALID_INFO_CLASS|X_STATUS_INVALID_PAGE_PROTECTION|X_STATUS_INVALID_PARAMETER|X_STATUS_INVALID_PARAMETER_1|X_STATUS_INVALID_PARAMETER_2|X_STATUS_INVALID_PARAMETER_3|X_STATUS_MAPPED_ALIGNMENT|X_STATUS_MEMORY_NOT_ALLOCATED|X_STATUS_MUTANT_NOT_OWNED|X_STATUS_NOT_A_DIRECTORY|X_STATUS_NOT_FOUND|X_STATUS_NOT_IMPLEMENTED|X_STATUS_NOT_SAME_DEVICE|X_STATUS_NOT_SUPPORTED|X_STATUS_NO_MEMORY|X_STATUS_NO_MORE_FILES|X_STATUS_NO_SUCH_FILE|X_STATUS_OBJECT_NAME_COLLISION|X_STATUS_OBJECT_NAME_EXISTS|X_STATUS_OBJECT_NAME_INVALID|X_STATUS_OBJECT_NAME_NOT_FOUND|X_STATUS_OBJECT_TYPE_MISMATCH|X_STATUS_PENDING|X_STATUS_PROCEDURE_NOT_FOUND|X_STATUS_PROCESS_IS_TERMINATING|X_STATUS_SEMAPHORE_LIMIT_EXCEEDED|X_STATUS_SHARING_VIOLATION|X_STATUS_SUCCESS|X_STATUS_THREAD_IS_TERMINATING|X_STATUS_TIMEOUT|X_STATUS_TIMER_RESUME_IGNORED|X_STATUS_UNSUCCESSFUL|X_STATUS_USER_APC|constant_v|is_be_type_v|is_flags_enum|is_mapped_ptr_v|is_precise_v|value)$'
  # XDK and Win32 mirror types
  - key: readability-identifier-naming.EnumIgnoredRegexp
    value: '^(IRQL_FLAGS|X_DISPATCHER_FLAGS|X_FILE_ATTRIBUTES|X_FILE_DEVICE_TYPE|X_FILE_FS_INFORMATION_CLASS|X_FILE_INFORMATION_CLASS|X_INPUT_CAPS|X_INPUT_DEVSUBTYPE|X_INPUT_DEVTYPE|X_INPUT_FLAG|X_INPUT_GAMEPAD_BUTTON|X_INPUT_KEYSTROKE_FLAGS|X_KTHREAD_STATE_FLAGS|X_MEM|X_PAGE)$'
  # a digit group may follow the prefix so Xenos formats keep their hardware names (charter 7.13), XDK and Win32 mirror types, Xenos and PowerPC documentation names
  - key: readability-identifier-naming.EnumConstantIgnoredRegexp
    value: '^k_[0-9][0-9A-Za-z_]*$|^(AVIVO_D1MODE_VIEWPORT_SIZE|AVIVO_D1SCL_SCALER_ENABLE|AVIVO_D1SCL_UPDATE|BC_DUMMY_CRAYRB_ENUMS|BC_DUMMY_CRAYRB_MOREENUMS|BC_PERFCOUNTER0_HI|BC_PERFCOUNTER0_LOW|BC_PERFCOUNTER0_SELECT|BC_PERFCOUNTER1_HI|BC_PERFCOUNTER1_LOW|BC_PERFCOUNTER1_SELECT|BC_PERFCOUNTER2_HI|BC_PERFCOUNTER2_LOW|BC_PERFCOUNTER2_SELECT|BC_PERFCOUNTER3_HI|BC_PERFCOUNTER3_LOW|BC_PERFCOUNTER3_SELECT|BIF_PERFCOUNTER0_HI|BIF_PERFCOUNTER0_LOW|BIF_PERFCOUNTER0_SELECT|BIOS_0_SCRATCH|BIOS_10_SCRATCH|BIOS_11_SCRATCH|BIOS_12_SCRATCH|BIOS_13_SCRATCH|BIOS_14_SCRATCH|BIOS_15_SCRATCH|BIOS_1_SCRATCH|BIOS_2_SCRATCH|BIOS_3_SCRATCH|BIOS_4_SCRATCH|BIOS_5_SCRATCH|BIOS_6_SCRATCH|BIOS_7_SCRATCH|BIOS_8_SCRATCH|BIOS_9_SCRATCH|CACHE_FLUSH|CACHE_FLUSH_AND_INV_EVENT|CACHE_FLUSH_AND_INV_TS_EVENT|CACHE_FLUSH_TS|CALLBACK_ACK|CALLBACK_ADDRESS|CALLBACK_CONTEXT|CAPTURE_START_STATUS|CGM_DRAM_CNTL_REG|CGM_MC0_IO_CNTL|CGM_MC1_IO_CNTL|CG_INT_ACK_REG|CG_INT_MASK_REG|CG_INT_STAT_REG|CG_SCRATCH1|COHER_BASE_HOST|COHER_BASE_PM4|COHER_BASE_RT|COHER_DEST_BASE_0|COHER_DEST_BASE_1|COHER_DEST_BASE_2|COHER_DEST_BASE_3|COHER_DEST_BASE_4|COHER_DEST_BASE_5|COHER_DEST_BASE_6|COHER_DEST_BASE_7|COHER_SIZE_HOST|COHER_SIZE_PM4|COHER_SIZE_RT|COHER_STATUS_HOST|COHER_STATUS_PM4|COHER_STATUS_RT|CONFIG_CNTL|CONFIG_XSTRAP|CONFIG_XSTRAP2|CONFIG_XSTRAP3|CONTEXT_DONE|CP_2D_BOOLEANS|CP_2D_BRUSH_BASE|CP_2D_IMMD_BASE|CP_2D_PALETTE_BASE|CP_BIN_MASK_HI|CP_BIN_MASK_LO|CP_BIN_SELECT_HI|CP_BIN_SELECT_LO|CP_CMD_DATA|CP_CMD_INDEX|CP_CPU_INT_CNTL|CP_CPU_INT_STATUS|CP_CSQ_AVAIL|CP_CSQ_IB1_STAT|CP_CSQ_IB2_STAT|CP_CSQ_RB_STAT|CP_D1_EOL_SOF_COUNTER|CP_D2_EOL_SOF_COUNTER|CP_DEBUG|CP_DEFAULT2_PITCH_OFFSET|CP_DEFAULT2_SC_BOTTOM_RIGHT|CP_DEFAULT_PITCH_OFFSET|CP_DEFAULT_SC_BOTTOM_RIGHT|CP_DMA_ACT_DSCR_STAT|CP_DMA_COMMAND|CP_DMA_COMMAND_STAT|CP_DMA_DST_ADDR|CP_DMA_DST_ADDR_STAT|CP_DMA_SRC_ADDR|CP_DMA_SRC_ADDR_STAT|CP_DMA_STAT|CP_DMA_TABLE_ADDR|CP_IB1_BASE|CP_IB1_BUFSZ|CP_IB2D_BASE|CP_IB2D_BUFSZ|CP_IB2_BASE|CP_IB2_BUFSZ|CP_INT_ACK|CP_INT_CNTL|CP_I