  # kernel export names are frozen (charter 4.9), and REX_SHIM_FN generates the rexshim_ names, standard style utility functions, C linkage names that assembly or the module ABI resolve by name, named by the C++ standard
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^__imp__.*|.*_entry$|^rexshim_.*|^ReXModule_.*|^(atomic_cas|atomic_dec|atomic_exchange|atomic_exchange_add|atomic_inc|atomic_store_release|bit_scan_forward|byte_swap|clamp_float|copy_and_swap|copy_and_swap_16_aligned|copy_and_swap_16_in_32_aligned|copy_and_swap_16_in_32_unaligned|copy_and_swap_16_unaligned|copy_and_swap_32_aligned|copy_and_swap_32_unaligned|copy_and_swap_64_aligned|copy_and_swap_64_unaligned|copy_and_swap_truncating|copy_truncating|from_string|hash_combine|is_pow2|load|load_and_swap|log2_ceil|log2_floor|lzcnt|m128_f32|m128_f64|m128_i32|m128_i64|make_fourcc|mul_div|next_pow2|reduce_fraction|rex_create_interface|rex_redirect_stub|rex_test_spin_leaf|rex_test_spin_prologue|rexmod_test_null_gpu_fail_textures|rexmod_test_set_sink|round_up|saturate|select_bits|stack_align|stack_bounds_check|stack_limit_from_pcr|stack_pop|stack_push|stack_push_string|store|store_and_swap|swap|to_hex_string|to_path|to_string|tzcnt|utf8_canonicalize_path|utf8_canonicalize_guest_path|utf8_count|utf8_ends_with|utf8_ends_with_case|utf8_equal_case|utf8_equal_case_z|utf8_equal_z|utf8_find_any_of|utf8_find_any_of_case|utf8_find_base_name_from_path|utf8_find_base_name_from_guest_path|utf8_find_base_path|utf8_find_base_guest_path|utf8_find_first_of|utf8_find_first_of_case|utf8_find_name_from_path|utf8_find_name_from_guest_path|utf8_fix_path_separators|utf8_hash_fnv1a|utf8_hash_fnv1a_case|utf8_join_paths|utf8_join_guest_paths|utf8_lower_ascii|utf8_split|utf8_split_path|utf8_starts_with|utf8_starts_with_case|utf8_upper_ascii|vec128b|vec128d|vec128f|vec128i|vec128q|vec128s)$'
  # linker symbols
  - key: readability-identifier-naming.GlobalConstantIgnoredRegexp
    value: '^(__ImageBase|__start_rexguest|__stop_rexguest)$'
  # names generated by Tracy's zone macros
  - key: readability-identifier-naming.LocalVariableIgnoredRegexp
    value: '^___tracy_.*'
  # read by the Windows SDK headers
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^(_WINSOCK_DEPRECATED_NO_WARNINGS)$'
