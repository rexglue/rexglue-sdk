# Stands in for the rexglue tool. Run with -DGENERATED=<folder> -P fake_rexglue.cmake -- codegen
# <manifest> [--max_file_size_bytes=N]. Writes ceil(2097152 / N) sources, the list that names them,
# the depfile and the build stamp, and rewrites a file only when its text changes.
set(SIZE 1048576)
set(INDEX 3)
while (INDEX LESS CMAKE_ARGC)
  if ("${CMAKE_ARGV${INDEX}}" MATCHES "^--max_file_size_bytes=([0-9]+)$")
    set(SIZE ${CMAKE_MATCH_1})
  endif ()
  math(EXPR INDEX "${INDEX} + 1")
endwhile ()
math(EXPR COUNT "(2097152 + ${SIZE} - 1) / ${SIZE}")

# write_if_changed(<path> <text>) rewrites the file only when the text differs.
function (write_if_changed path text)
  set(old "")
  if (EXISTS ${path})
    file(READ ${path} old)
  endif ()
  if (NOT old STREQUAL text)
    file(WRITE ${path} "${text}")
  endif ()
endfunction ()

file(MAKE_DIRECTORY ${GENERATED})
set(LIST_TEXT "set(GENERATED_SOURCES\n")
set(PART 1)
while (PART LESS_EQUAL COUNT)
  write_if_changed(${GENERATED}/part_${PART}.cpp "int part_${PART}() { return ${PART}; }\n")
  string(APPEND LIST_TEXT "    ${GENERATED}/part_${PART}.cpp\n")
  math(EXPR PART "${PART} + 1")
endwhile ()
string(APPEND LIST_TEXT ")\n")
file(GLOB existing ${GENERATED}/part_*.cpp)
foreach (file IN LISTS existing)
  string(REGEX REPLACE ".*part_([0-9]+)\\.cpp" "\\1" number ${file})
  if (number GREATER COUNT)
    file(REMOVE ${file})
  endif ()
endforeach ()
write_if_changed(${GENERATED}/sources.cmake "${LIST_TEXT}")
write_if_changed(
  ${GENERATED}/codegen.d "${GENERATED}/codegen.build.stamp: ${CMAKE_CURRENT_LIST_FILE}\n"
)
file(WRITE ${GENERATED}/codegen.build.stamp "${size}\n")
