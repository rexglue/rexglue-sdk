# Builds the probe project with a changing generated file size. Run with -DREXGLUE_ROOT=<sdk root>
# -DWORK_DIR=<scratch folder> -DCXX_COMPILER=<compiler> -DNINJA=<ninja>.
set(PROBE ${REXGLUE_ROOT}/tests/cmake/codegen_stale)
set(TREE ${WORK_DIR}/tree)
file(REMOVE_RECURSE ${WORK_DIR})

# run(<result> <command...>) runs a command, keeps its output in <result> and fails on a bad exit.
function (run result)
  execute_process(
    COMMAND ${ARGN}
    RESULT_VARIABLE code
    OUTPUT_VARIABLE output
    ERROR_VARIABLE output
  )
  if (NOT code EQUAL 0)
    message(FATAL_ERROR "${ARGN} failed with ${code}\n${output}")
  endif ()
  set(${result}
      "${output}"
      PARENT_SCOPE
  )
endfunction ()

# configure(<size>) configures the probe with the generated file size, empty for the default.
function (configure size)
  run(ignored
      ${CMAKE_COMMAND}
      -S
      ${PROBE}
      -B
      ${TREE}
      -G
      Ninja
      -DCMAKE_MAKE_PROGRAM=${NINJA}
      -DCMAKE_CXX_COMPILER=${CXX_COMPILER}
      -DREXGLUE_ROOT=${REXGLUE_ROOT}
      -DREXGLUE_RECOMP_MAX_FILE_SIZE=${size}
  )
endfunction ()

# build(<result>) builds the probe tree.
function (build result)
  run(output ${NINJA} -C ${TREE})
  set(${result}
      "${output}"
      PARENT_SCOPE
  )
endfunction ()

# count_objects(<result>) counts the object files the probe library has.
function (count_objects result)
  file(GLOB_RECURSE objects ${TREE}/CMakeFiles/probe.dir/*.o ${TREE}/CMakeFiles/probe.dir/*.obj)
  list(LENGTH objects count)
  set(${result}
      ${count}
      PARENT_SCOPE
  )
endfunction ()

# A tree generated by hand at 1 MiB, then built.
run(ignored
    ${CMAKE_COMMAND}
    -DGENERATED=${TREE}/generated
    -P
    ${PROBE}/fake_rexglue.cmake
    --
    codegen
    manifest
)
configure("")
build(output)
count_objects(count)
if (NOT count EQUAL 2)
  message(FATAL_ERROR "expected 2 objects at the default size, found ${count}\n${output}")
endif ()

# The size drops to 512 KiB, so the build must regenerate and compile the new list.
configure(524288)
build(output)
count_objects(count)
if (NOT count EQUAL 4)
  message(FATAL_ERROR "expected 4 objects at 512 KiB, found ${count}\n${output}")
endif ()

# Nothing changed, so a second build has no work to do.
build(output)
if (NOT output MATCHES "no work to do")
  message(FATAL_ERROR "an unchanged tree rebuilt\n${output}")
endif ()

# The size rises to 1 MiB, so the extra sources go away and the build still succeeds.
# Objects of the removed sources stay in the tree, so the source files are counted.
configure(1048576)
build(output)
file(GLOB sources ${TREE}/generated/part_*.cpp)
list(LENGTH sources SOURCE_COUNT)
if (NOT SOURCE_COUNT EQUAL 2)
  message(FATAL_ERROR "expected 2 sources at 1 MiB, found ${SOURCE_COUNT}\n${output}")
endif ()
