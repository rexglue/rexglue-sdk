# {{ names.original }} - ReXGlue Recompiled Project
#
# The SDK package provides rexglue_project and the rexglue_setup_* functions.

cmake_minimum_required(VERSION 3.25)
project({{ names.original }} LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

if (REXSDK_DIR)
  add_subdirectory("{{ cmake_var("REXSDK_DIR") }}" rexglue-sdk)
else ()
  find_package(rexglue {{ sdk_version }} REQUIRED CONFIG)
endif ()
rexglue_project({{ names.original }}{% if entrypoint_out_dir != "generated" %} OUTPUT_DIR {{ entrypoint_out_dir }}{% endif %})

# Host sources. src/main.cpp stays on the executable.
set({{ names.upper_case }}_HOST_SOURCES src/{{ names.original }}_hooks.cpp)

# OBJECT and never STATIC, an archive drops the REX_EXPORT symbols.
add_library({{ names.original }}_common OBJECT {{ cmake_var(names.upper_case + "_HOST_SOURCES") }})
rexglue_setup_host_library({{ names.original }}_common)

if (WIN32)
  add_executable({{ names.original }} WIN32 src/main.cpp)
else ()
  add_executable({{ names.original }} src/main.cpp)
endif ()

rexglue_setup_target({{ names.original }})
target_link_libraries({{ names.original }} PRIVATE {{ names.original }}_common)
