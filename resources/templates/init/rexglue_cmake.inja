# Auto-generated by rexglue - DO NOT EDIT

# SDK version
# REXSDK_VERSION pins the SDK version.
# Otherwise, the version of the SDK that generated this file is used.
set(REXSDK_VERSION
    ""
    CACHE STRING "Override SDK version (leave empty for default)"
)

# Find SDK
set(REXSDK_DIR
    ""
    CACHE PATH "Path to rexglue-sdk source tree"
)
if (REXSDK_DIR)
  add_subdirectory("{{ cmake_var("REXSDK_DIR") }}" rexglue-sdk)
  message(STATUS "Using ReXGlue SDK from source tree: {{ cmake_var("REXSDK_DIR") }}")
else ()
  if (REXSDK_VERSION)
    find_package(rexglue {{ cmake_var("REXSDK_VERSION") }} EXACT QUIET CONFIG)
  else ()
    find_package(rexglue {{ sdk_version }} QUIET CONFIG)
  endif ()
  if (NOT rexglue_FOUND)
    message(
      FATAL_ERROR
        "ReXGlue SDK not found. Set REXSDK_DIR to the rexglue-sdk source tree "
        "(e.g. thirdparty/rexglue-sdk)\n"
        "or install the SDK package and add it to CMAKE_PREFIX_PATH"
    )
  endif ()
  message(STATUS "Found ReXGlue SDK ${REXGLUE_VERSION_STRING} at ${rexglue_DIR}")
endif ()

# Host target name used by the dll_targets.cmake that codegen emits to colocate
# guest DLLs with the host EXE. Defaults to PROJECT_NAME (which the
# init flow that starts from the manifest sets equal to the host target name).
if (NOT DEFINED REXGLUE_HOST_TARGET)
  set(REXGLUE_HOST_TARGET {{ cmake_var("PROJECT_NAME") }})
endif ()

set(REXGLUE_RECOMP_DEBUG_INFO
    "line-tables-only"
    CACHE STRING "Debug info level for generated code (line-tables-only, full or none)"
)

# Guest SEH scopes emit __try/__except, which traps hardware faults only under
# asynchronous EH. clang++ takes that flag in the GNU form.
set(REXGLUE_RECOMP_OPTIONS "")
if (WIN32)
  if (MSVC)
    list(APPEND REXGLUE_RECOMP_OPTIONS /EHa)
  elseif (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    list(APPEND REXGLUE_RECOMP_OPTIONS -fasync-exceptions)
  endif ()
else ()
  list(APPEND REXGLUE_RECOMP_OPTIONS -fasynchronous-unwind-tables)
endif ()
if (REXGLUE_RECOMP_DEBUG_INFO STREQUAL "none")
  list(APPEND REXGLUE_RECOMP_OPTIONS $<$<CXX_COMPILER_ID:Clang,AppleClang,GNU>:-g0>)
elseif (REXGLUE_RECOMP_DEBUG_INFO STREQUAL "line-tables-only")
  list(APPEND REXGLUE_RECOMP_OPTIONS $<$<CXX_COMPILER_ID:Clang,AppleClang>:-gline-tables-only>)
endif ()

set(REXGLUE_RECOMP_OPTIMIZATION
    ""
    CACHE STRING
          "Optimization level for generated code (empty keeps the build type default, or O0 to O3)"
)
set_property(CACHE REXGLUE_RECOMP_OPTIMIZATION PROPERTY STRINGS "" O0 O1 O2 O3)
if (NOT REXGLUE_RECOMP_OPTIMIZATION STREQUAL "")
  if (NOT REXGLUE_RECOMP_OPTIMIZATION MATCHES "^O[0-3]$")
    message(FATAL_ERROR "REXGLUE_RECOMP_OPTIMIZATION must be empty or one of O0, O1, O2, O3 "
                        "(got '{{ cmake_var("REXGLUE_RECOMP_OPTIMIZATION") }}')"
    )
  endif ()
  if (MSVC)
    set(_rexglue_rtc_policy "")
    if (POLICY CMP0184)
      cmake_policy(GET CMP0184 _rexglue_rtc_policy)
    endif ()
    if (NOT _rexglue_rtc_policy STREQUAL "NEW")
      message(
        FATAL_ERROR
          "REXGLUE_RECOMP_OPTIMIZATION with cl or clang-cl needs CMake 4.0 or later and "
          "cmake_policy(SET CMP0184 NEW) before project(). Otherwise configure with the "
          "GNU style clang driver the presets pin."
      )
    endif ()
    if (CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
      list(APPEND REXGLUE_RECOMP_OPTIONS /clang:-{{ cmake_var("REXGLUE_RECOMP_OPTIMIZATION") }})
    elseif (REXGLUE_RECOMP_OPTIMIZATION STREQUAL "O0")
      list(APPEND REXGLUE_RECOMP_OPTIONS /Od)
    elseif (REXGLUE_RECOMP_OPTIMIZATION STREQUAL "O1")
      list(APPEND REXGLUE_RECOMP_OPTIONS /O2 /Ob1)
    else ()
      list(APPEND REXGLUE_RECOMP_OPTIONS /O2 /Ob2)
    endif ()
  else ()
    list(APPEND REXGLUE_RECOMP_OPTIONS -{{ cmake_var("REXGLUE_RECOMP_OPTIMIZATION") }})
  endif ()
endif ()

# Include entrypoint generated code if codegen has been run.
if (EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/sources.cmake")
  include({{ entrypoint_out_dir }}/sources.cmake)
  set(REXGLUE_ENTRYPOINT_GENERATED_SOURCES {{ cmake_var("GENERATED_SOURCES") }})
  set(REXGLUE_ENTRYPOINT_INCLUDE_DIR "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}")

  # Carried on the sources so they hold for whichever target compiles them.
  set_source_files_properties(
    {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }} PROPERTIES COMPILE_OPTIONS
                                                          "{{ cmake_var("REXGLUE_RECOMP_OPTIONS") }}"
  )
endif ()

# The options go on the target as well. CMake compiles the header from its own
# cmake_pch.hxx.cxx, which carries none of the source properties above, and
# clang rejects a PCH whose EH mode disagrees with the TU including it.
function (rexglue_apply_recomp_settings target_name pch_header)
  target_precompile_headers({{ cmake_var("target_name") }} PRIVATE "{{ cmake_var("pch_header") }}")
  target_compile_options({{ cmake_var("target_name") }} PRIVATE {{ cmake_var("REXGLUE_RECOMP_OPTIONS") }})
  if (MSVC AND NOT REXGLUE_RECOMP_OPTIMIZATION STREQUAL "")
    set_target_properties({{ cmake_var("target_name") }} PROPERTIES MSVC_RUNTIME_CHECKS "")
  endif ()
endfunction ()

# Applies the SDK settings, include paths and codegen dependency to a host library.
macro (rexglue_setup_host_library library_name)
  rexglue_apply_target_settings({{ cmake_var("library_name") }})
  target_include_directories(
    {{ cmake_var("library_name") }} PRIVATE {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }} {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/src
                               {{ cmake_var("REXGLUE_ENTRYPOINT_INCLUDE_DIR") }}
  )
  target_link_libraries({{ cmake_var("library_name") }} PRIVATE rex::sdk)
  add_dependencies({{ cmake_var("library_name") }} {{ names.original }}_codegen)
endmacro ()

# Configure a rexglue target with SDK libraries and platform settings.
macro (rexglue_setup_target target_name)
  if (REXGLUE_ENTRYPOINT_GENERATED_SOURCES AND NOT TARGET {{ names.original }}_recompiled)
    add_library({{ names.original }}_recompiled OBJECT {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }})
    target_include_directories(
      {{ names.original }}_recompiled PRIVATE {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }} {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/src
                                {{ cmake_var("REXGLUE_ENTRYPOINT_INCLUDE_DIR") }}
    )
    target_link_libraries({{ names.original }}_recompiled PRIVATE rex::sdk)
    set_source_files_properties(
      {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }} PROPERTIES COMPILE_OPTIONS ""
    )
    rexglue_apply_target_settings({{ names.original }}_recompiled)
    rexglue_apply_recomp_settings(
      {{ names.original }}_recompiled "{{ cmake_var("REXGLUE_ENTRYPOINT_INCLUDE_DIR") }}/{{ names.original }}_pch.h"
    )
    add_dependencies({{ names.original }}_recompiled {{ names.original }}_codegen)
  endif ()
  if (TARGET {{ names.original }}_recompiled)
    target_link_libraries({{ cmake_var("target_name") }} PRIVATE {{ names.original }}_recompiled)
  endif ()
  # Also on the host, so a tree that has never run codegen generates it.
  add_dependencies({{ cmake_var("target_name") }} {{ names.original }}_codegen)
  target_include_directories(
    {{ cmake_var("target_name") }} PRIVATE {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }} {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/src
                              {{ cmake_var("REXGLUE_ENTRYPOINT_INCLUDE_DIR") }}
  )
  target_link_libraries({{ cmake_var("target_name") }} PRIVATE rex::sdk)
  if (EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/metadata/icons")
    rexglue_embed_metadata(
      {{ cmake_var("target_name") }} DIRECTORY "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/metadata/icons" PREFIX "icons"
    )
  endif ()
  rexglue_configure_target({{ cmake_var("target_name") }} {{ cmake_var("ARGN") }})
endmacro ()

# Codegen runs as part of the build, re-running only when an input in codegen.d
# changes.
# Listing the sources as outputs orders any target that compiles them after
# codegen, including one a project assembles itself rather than taking the
# library rexglue_setup_target() builds. The stamp comes first because the DEPFILE
# names it.
add_custom_command(
  OUTPUT "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.build.stamp"
         {{ cmake_var("REXGLUE_ENTRYPOINT_GENERATED_SOURCES") }}
  COMMAND $<TARGET_FILE:rex::rexglue> codegen {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ names.original }}_manifest.toml
  DEPFILE "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.d"
  WORKING_DIRECTORY {{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}
  COMMENT "Generating recompiled code for {{ names.original }}"
  VERBATIM
)
add_custom_target(
  {{ names.original }}_codegen
  COMMENT "Checking recompiled code for {{ names.original }}"
  DEPENDS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/codegen.build.stamp"
)

# Include DLL module shared library targets if codegen has generated them
if (EXISTS "{{ cmake_var("CMAKE_CURRENT_SOURCE_DIR") }}/{{ entrypoint_out_dir }}/dll_targets.cmake")
  include({{ entrypoint_out_dir }}/dll_targets.cmake)
endif ()
