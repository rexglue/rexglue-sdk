//=============================================================================
// ReXGlue Generated - {{ project }} Module Registry
//=============================================================================

#include <rex/runtime/module_registry.h>

void RegisterRecompiledModules(rex::runtime::IModuleRegistry& modules) {
{% for mod in dll_modules %}
  modules.RegisterRecompiledModule(
      "{{ mod.pe_name }}",
      "{{ mod.guest_path }}",
      "{{ mod.shared_lib_name }}");
{% endfor %}
}
