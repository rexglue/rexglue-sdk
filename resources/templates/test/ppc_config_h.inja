// Function definition macros (same as the codegen pch header)
#ifndef DECLARE_REX_FUNC
#define DECLARE_REX_FUNC(name) \
  REX_EXTERN(name);            \
  REX_EXTERN(__imp__##name)
#endif

#ifndef DEFINE_REX_FUNC
#if defined(__APPLE__)
// Darwin has no overridable alias (see codegen/pch_h.inja), so use a weak
// musttail thunk so `name` stays overridable by hooks and lowers to a `jmp`.
#define DEFINE_REX_FUNC(name)                                            \
  extern "C" void __imp__##name(PPCContext& __restrict, u8*);            \
  __attribute__((weak, noinline)) extern "C" void name(                  \
      PPCContext& __restrict ctx, u8* base) {                            \
    [[clang::musttail]] return __imp__##name(ctx, base);                 \
  }                                                                      \
  REX_RECOMPILED_CODE_SECTION extern "C" void __imp__##name([[maybe_unused]] PPCContext& __restrict ctx, u8* base)
#else
#define DEFINE_REX_FUNC(name)                                       \
  __attribute__((alias("__imp__" #name)))                           \
  __attribute__((weak, noinline)) extern "C" REX_FUNC(name);        \
  REX_RECOMPILED_CODE_SECTION REX_EXTERN(__imp__##name)
#endif
#endif

