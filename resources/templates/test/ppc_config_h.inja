#define REX_MM_STORE_U64(addr, val)                                              \
  do {                                                                           \
    u32 _mmio_addr = (addr);                                                     \
    if (rex::IsMMIOBlockAddress(_mmio_addr)) {                                   \
      u64 _mmio_value = static_cast<u64>(val);                                   \
      rex::ppc::MMIOStore32(_mmio_addr, static_cast<u32>(_mmio_value >> 32));   \
