set(REXGLUE_RUNTIME_OBJECT_LIBS rex-ui)
set(REXGLUE_ABOVE_CORE_TARGETS rex-runtime rex-filesystem rex-ui rex-gpu rex-gpu-xenos rex-codegen rex-apu-sdl3 rex-hid-common rex-hid-sdl3 rex-hid-xinput)
set(REXGLUE_REGISTRAR_REGEX "REXCVAR_DEFINE_|REXLOG_DEFINE_CATEGORY|REXLOG_DEFINE_SUBCATEGORY")

function(_rexglue_collect_targets dir out_var)
    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
    foreach(subdir IN LISTS subdirs)
        _rexglue_collect_targets("${subdir}" sub_targets)
        list(APPEND targets ${sub_targets})
    endforeach()
    set(${out_var} "${targets}" PARENT_SCOPE)
endfunction()

function(_rexglue_resolve_alias name out_var)
    if(TARGET "${name}")
        get_target_property(aliased "${name}" ALIASED_TARGET)
        if(aliased)
            set(${out_var} "${aliased}" PARENT_SCOPE)
            return()
        endif()
    endif()
    set(${out_var} "${name}" PARENT_SCOPE)
endfunction()

function(rexglue_audit_core_linkage)
    _rexglue_collect_targets("${CMAKE_CURRENT_SOURCE_DIR}" all_targets)

    set(violations "")
    foreach(target IN LISTS all_targets)
        if(target STREQUAL "rex-runtime")
            continue()
        endif()

        get_target_property(type ${target} TYPE)
        if(NOT type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            continue()
        endif()

        get_target_property(links ${target} LINK_LIBRARIES)
        if(NOT links)
            continue()
        endif()
        set(resolved "")
        foreach(lib IN LISTS links)
            _rexglue_resolve_alias("${lib}" real)
            list(APPEND resolved "${real}")
        endforeach()
        if(NOT "rex-runtime" IN_LIST resolved)
            continue()
        endif()

        foreach(lib IN LISTS REXGLUE_RUNTIME_OBJECT_LIBS)
            if("${lib}" IN_LIST resolved)
                list(APPEND violations "  ${target} links rex-runtime and ${lib}")
            endif()
        endforeach()
    endforeach()

    if(violations)
        list(JOIN violations "\n" detail)
        message(FATAL_ERROR
            "rex-core objects would be duplicated:\n${detail}\n"
            "rex-runtime already contains them. Drop the direct link.")
    endif()
endfunction()

function(rexglue_audit_module_registrars)
    _rexglue_collect_targets("${CMAKE_CURRENT_SOURCE_DIR}" all_targets)
    set(violations "")
    foreach(target IN LISTS all_targets)
        get_target_property(type ${target} TYPE)
        if(NOT type MATCHES "^(SHARED_LIBRARY|MODULE_LIBRARY)$")
            continue()
        endif()
        get_target_property(sources ${target} SOURCES)
        get_target_property(source_dir ${target} SOURCE_DIR)
        foreach(source IN LISTS sources)
            if(NOT source MATCHES "\\.(cpp|cc|cxx|h|inc)$")
                continue()
            endif()
            if(IS_ABSOLUTE "${source}")
                set(full "${source}")
            else()
                set(full "${source_dir}/${source}")
            endif()
            if(NOT EXISTS "${full}")
                continue()
            endif()
            file(STRINGS "${full}" hits REGEX "${REXGLUE_REGISTRAR_REGEX}")
            if(NOT hits)
                continue()
            endif()
            file(RELATIVE_PATH rel "${PROJECT_SOURCE_DIR}" "${full}")
            list(APPEND violations "  ${target}:${rel}")
        endforeach()
    endforeach()

    if(violations)
        list(JOIN violations "\n" detail)
        message(FATAL_ERROR
            "static registrars in module DLLs (charter 4.7):\n${detail}\n"
            "Register at Connect instead.")
    endif()
endfunction()

function(rexglue_audit_core_tier)
    get_target_property(links rex-core LINK_LIBRARIES)
    set(violations "")
    foreach(lib IN LISTS links)
        _rexglue_resolve_alias("${lib}" real)
        if("${real}" IN_LIST REXGLUE_ABOVE_CORE_TARGETS)
            list(APPEND violations "  rex-core links ${real}")
        endif()
    endforeach()
    if(violations)
        list(JOIN violations "
" detail)
        message(FATAL_ERROR "rex-core is tier 0 and links no SDK target (charter 2.2):
${detail}")
    endif()
endfunction()

function(rexglue_audit_module_links)
    _rexglue_collect_targets("${CMAKE_CURRENT_SOURCE_DIR}" all_targets)
    set(violations "")
    foreach(target IN LISTS all_targets)
        get_target_property(links ${target} LINK_LIBRARIES)
        if(NOT links)
            continue()
        endif()
        foreach(lib IN LISTS links)
            _rexglue_resolve_alias("${lib}" real)
            if("${real}" STREQUAL "rex-filesystem")
                list(APPEND violations "  ${target} links rex-filesystem")
            endif()
        endforeach()
    endforeach()
    if(violations)
        list(JOIN violations "\n" detail)
        message(FATAL_ERROR
            "rex-filesystem is a module loaded through rex::Init and is never linked (charter 4):\n"
            "${detail}")
    endif()
endfunction()

function(rexglue_audit_ui_links)
    set(forbidden rex-gpu-xenos d3d12 dxgi dxguid Vulkan::Headers
        GPUOpen::VulkanMemoryAllocator spirv-tools-headers dxc-headers)
    get_target_property(links rex-ui LINK_LIBRARIES)
    get_target_property(interface_links rex-ui INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS links interface_links)
        if(link IN_LIST forbidden)
            message(FATAL_ERROR "link audit: rex-ui links the backend library ${link}")
        endif()
    endforeach()
endfunction()

rexglue_audit_core_linkage()
rexglue_audit_core_tier()
rexglue_audit_module_registrars()
rexglue_audit_module_links()
rexglue_audit_ui_links()

function(rexglue_audit_host_service_links)
    set(host_libs SDL3::SDL3 SDL3::SDL3-shared SDL3::SDL3-static xinput d3d12 dxgi dxguid
        Vulkan::Headers GPUOpen::VulkanMemoryAllocator imgui)
    foreach(target IN ITEMS rex-hid-common rex-gpu)
        if(NOT TARGET ${target})
            continue()
        endif()
        get_target_property(links ${target} LINK_LIBRARIES)
        get_target_property(interface_links ${target} INTERFACE_LINK_LIBRARIES)
        foreach(link IN LISTS links interface_links)
            if(link IN_LIST host_libs)
                message(FATAL_ERROR "link audit: ${target} links the host library ${link}")
            endif()
        endforeach()
    endforeach()
    set(module_allowed
        "rex-apu-sdl3=rex-core|SDL3::SDL3"
        "rex-hid-sdl3=rex-core|rex-hid-common|SDL3::SDL3"
        "rex-hid-xinput=rex-core|rex-hid-common")
    foreach(entry IN LISTS module_allowed)
        string(REPLACE "=" ";" pair "${entry}")
        list(GET pair 0 module)
        list(GET pair 1 allowed)
        string(REPLACE "|" ";" allowed "${allowed}")
        if(NOT TARGET ${module})
            continue()
        endif()
        get_target_property(links ${module} LINK_LIBRARIES)
        foreach(link IN LISTS links)
            if(NOT link IN_LIST allowed)
                message(FATAL_ERROR "link audit: ${module} links ${link}, allowed are ${allowed}")
            endif()
        endforeach()
    endforeach()
    get_target_property(runtime_links rex-runtime LINK_LIBRARIES)
    foreach(link IN LISTS runtime_links)
        if(link MATCHES "^rex-(apu|hid)-")
            message(FATAL_ERROR "link audit: rex-runtime links the host module ${link}")
        endif()
    endforeach()
endfunction()

rexglue_audit_host_service_links()
