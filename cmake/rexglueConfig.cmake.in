@PACKAGE_INIT@

set(REXGLUE_VERSION_STRING "@REXGLUE_FULL_VERSION@")

# What the package was built with.
# REXGLUE_STDLIB and REXGLUE_LIBSTDCXX_RELEASE are set on Linux only.
set(REXGLUE_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(REXGLUE_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(REXGLUE_STDLIB "@REXGLUE_STDLIB@")
set(REXGLUE_LIBSTDCXX_RELEASE "@REXGLUE_LIBSTDCXX_RELEASE@")

set(REXGLUE_MOLTENVK_ICD
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/vulkan/icd.d/MoltenVK_icd.json"
)

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/rexglue_target.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/rexglue_module.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/rexglue_metadata.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/rexglue_project.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/rexglue_stdlib.cmake")

rexglue_check_stdlib()

list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

find_dependency(Threads)
if (NOT WIN32)
  find_dependency(Iconv)
endif ()
find_dependency(SDL3 CONFIG)

set(_rexglue_created_targets "")
foreach (_rexglue_imported IN ITEMS @REXGLUE_IMPORTED_MODULES@)
  if (NOT TARGET ${_rexglue_imported})
    add_library(${_rexglue_imported} SHARED IMPORTED)
    set_target_properties(${_rexglue_imported} PROPERTIES MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    list(APPEND _rexglue_created_targets ${_rexglue_imported})
  endif ()
endforeach ()
file(GLOB _rexglue_module_files "${CMAKE_CURRENT_LIST_DIR}/rexglueModules-*.cmake")
foreach (_rexglue_module_file IN LISTS _rexglue_module_files)
  include("${_rexglue_module_file}")
endforeach ()

if (APPLE)
  if (NOT TARGET rex::vulkan-loader)
    add_library(rex::vulkan-loader SHARED IMPORTED)
    set_target_properties(
      rex::vulkan-loader
      PROPERTIES IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libvulkan.1.dylib"
    )
  endif ()

  if (NOT TARGET rex::moltenvk)
    add_library(rex::moltenvk SHARED IMPORTED)
    set_target_properties(
      rex::moltenvk PROPERTIES IMPORTED_LOCATION
                               "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libMoltenVK.dylib"
    )
  endif ()
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/rexglueTargets.cmake")

# Only Release rexglue is installed, so every consumer config has to reach it.
if (TARGET rex::rexglue)
  set_target_properties(
    rex::rexglue
    PROPERTIES MAP_IMPORTED_CONFIG_DEBUG Release
               MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
               MAP_IMPORTED_CONFIG_MINSIZEREL Release
  )
endif ()

if (NOT rexglue_FIND_QUIETLY)
  message(STATUS "Found ReXGlue SDK ${REXGLUE_VERSION_STRING} at (${PACKAGE_PREFIX_DIR})")
endif ()

check_required_components(rexglue)
