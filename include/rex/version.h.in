#pragma once

#include <rex/platform.h>

#define REXGLUE_VERSION_MAJOR @REXGLUE_DERIVED_MAJOR@
#define REXGLUE_VERSION_MINOR @REXGLUE_DERIVED_MINOR@
#define REXGLUE_VERSION_PATCH @REXGLUE_DERIVED_PATCH@
#define REXGLUE_VERSION_TWEAK @REXGLUE_DERIVED_TWEAK@
#define REXGLUE_VERSION_STRING "@REXGLUE_FULL_VERSION@"
#define REXGLUE_VERSION_NUMERIC "@REXGLUE_NUMERIC_VERSION@"
#define REXGLUE_VERSION_FLOOR "@REXGLUE_FLOOR_VERSION@"
#define REXGLUE_VERSION_CHANNEL "@REXGLUE_VERSION_CHANNEL@"

#define REXGLUE_BUILD_PLATFORM "@REX_PLATFORM@"
#define REXGLUE_BUILD_IDENTITY "@REXGLUE_BUILD_IDENTITY@"

/** Build title such as "[rexglue-v0.7.5.38-dev.gb27f3f74-Release]". Needs REXGLUE_BUILD_CONFIG. */
#define REXGLUE_BUILD_LABEL \
  "[rexglue-v" REXGLUE_VERSION_STRING "-" REXGLUE_BUILD_CONFIG "]"

namespace rex {

/**
 * Returns the build stamp. The time in it is the configure time of the build tree.
 *
 * @code
 * "build: rexglue-v0.7.5.38-dev.gb27f3f74-win-amd64-Release@20260420_1430"
 * @endcode
 *
 * @return The stamp, a string that lasts for the life of the process.
 */
REX_API const char* GetBuildStamp();

}  // namespace rex
